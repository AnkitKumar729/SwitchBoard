# Copy this file to .env and fill in real values. Never commit .env.

# --- backend ---
# Comma-separated key pool, at least 2 keys. Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model name. Every key above must belong to this model's provider.
# Any LiteLLM model name works, for example gemini/gemini-3.8-flash or anthropic/claude-haiku-5-5.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional: base URL of a self-hosted or OpenAI-compatible provider. Leave empty for the provider's own API.
LLM_API_BASE=
# SQLite location. /data is the Docker volume.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins: the URL(s) the frontend is served from.
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure failover test hook.
ENABLE_FAILURE_SIMULATION=true

# --- frontend ---
# Backend URL the browser calls. Read when the frontend is built.
VITE_API_BASE_URL=http://localhost:8000
